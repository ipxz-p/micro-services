generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}

model OutboxMessage {
  id           String    @id @default(uuid())
  topic        String
  partitionKey String
  payload      Json
  createdAt    DateTime  @default(now())
  publishedAt  DateTime?
  attempts     Int       @default(0)
  lastError    String?

  /// relay สนใจแค่แถวที่ publishedAt = null เรียงตาม createdAt
  @@index([publishedAt, createdAt])
}
