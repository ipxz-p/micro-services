{
  "name": "@micro-service/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many --target=serve --all",
    "lint": "nx run-many -t lint --all",
    "test": "nx run-many -t test --all",
    "build": "nx run-many -t build --all",
    "proto:sync": "nx run proto-contracts:proto-generate",
    "proto:check": "nx run proto-contracts:proto-check",
    "db:migrate": "nx run user-service:prisma-migrate",
    "db:deploy": "nx run user-service:prisma-migrate-deploy",
    "db:studio": "nx run user-service:prisma-studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "stack:up": "docker compose -f docker-compose.yml -f docker-compose.apps.yml --profile apps up -d --build",
    "stack:down": "docker compose -f docker-compose.yml -f docker-compose.apps.yml --profile apps down"
  },
  "private": true,
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
